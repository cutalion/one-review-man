{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Book Configuration",
  "type": "object",
  "required": ["localized", "generation"],
  "properties": {
    "localized": {
      "type": "object",
      "patternProperties": {
        "^[a-z]{2}$": {
          "type": "object",
          "required": ["title", "description"],
          "properties": {
            "title": { "type": "string" },
            "subtitle": { "type": "string" },
            "author": { "type": "string" },
            "genre": { "type": "string" },
            "humor_style": { "type": "string" },
            "setting": { "type": "string" },
            "themes": {
              "type": "object",
              "properties": {
                "primary": { "type": "string" },
                "secondary": { "type": "array", "items": { "type": "string" } }
              }
            }
          }
        }
      }
    },
    "generation": {
      "type": "object",
      "properties": {
        "chapter_length_target": { "type": "string" },
        "complexity_level": { "type": "string" },
        "character_consistency": { "type": "boolean" },
        "content_rules": { "type": "object" },
        "translation_rules": { "type": "object" }
      }
    },
    "site_url": { "type": "string" },
    "twitter_username": { "type": "string" },
    "github_username": { "type": "string" },
    "site_domain": { "type": "string" }
  }
}
